# 复制为 .env 后按需修改；.env 已在 .gitignore 中，不会被提交

# 共享额度（项目方提供的免费 AI）的使用密码
ZY_ACCESS_PASSWORD=change-me

# ---- 共享免费额度（可选）----
# 任意 OpenAI 兼容端点都可以。不填则"共享额度"选项不可用，用户仍可用模板解释或自带 Key。
# 例：校内网关（需学校分配的 Key）
# ZY_SHARED_AI_KEY=sk-xxxx
# ZY_SHARED_AI_BASE_URL=https://myai.bupt.edu.cn/llm-gw/v1
# ZY_SHARED_AI_MODEL=qwen3.8-27b
# 每个会话最多调用多少次（默认 20）
# ZY_SHARED_AI_LIMIT=20

# ---- 默认模型（自带 Key 模式下的初始值）----
# ZY_LLM_BASE_URL=https://myai.bupt.edu.cn/llm-gw/v1
# ZY_LLM_MODEL=qwen3.8-27b
