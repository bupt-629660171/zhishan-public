<view class="wrap">

  <!-- 首屏 -->
  <view class="hero">
    <view class="bowl">
      <view
        wx:for="{{bowl}}"
        wx:key="id"
        class="px"
        style="left:{{item.x}}rpx;top:{{item.y}}rpx;width:{{item.w}}rpx;height:{{item.h}}rpx;background:{{item.c}}"
      ></view>
      <view class="steam" style="left:60rpx;top:-16rpx"></view>
      <view class="steam" style="left:96rpx;top:-30rpx;animation-delay:.9s"></view>
    </view>

    <view class="hero-copy">
      <view class="hero-kicker">ZHIYUAN · DAILY FOOD</view>
      <view class="hero-title">今天吃什么，<br/>先看看身体感受</view>
      <view class="hero-desc">从最近两周的真实感受出发，挑出更合适的那一餐，每条建议都带规则出处。</view>
    </view>
  </view>

  <!-- 本周进度 -->
  <view class="progress">
    <view class="lab">本周记录 <text>{{recorded}}</text> / 14 天</view>
    <view class="seg">
      <view wx:for="{{segs}}" wx:key="id" class="s {{item.on ? 'on' : (item.today ? 'today' : '')}}"></view>
    </view>
  </view>

  <!-- 任务节点 -->
  <view class="quest">
    <view wx:for="{{quest}}" wx:key="t" class="node {{item.cls}}">
      <view class="t">{{item.t}}</view>
      <view class="s">{{item.s}}</view>
    </view>
  </view>

  <!-- 状态 -->
  <view class="section-title">你的状态更接近</view>
  <view class="section-sub">只作饮食参考，不构成诊断 · 规则版本 {{ruleVersion}}</view>
  <view class="chips">
    <view
      wx:for="{{constitutions}}"
      wx:key="name"
      class="chip {{picked === item.name ? 'on' : ''}}"
      data-name="{{item.name}}"
      bindtap="pickConstitution"
    >{{item.name}}</view>
  </view>
  <view class="section-sub" style="margin-top:14rpx">{{pickedDesc}}</view>

  <view class="card" style="display:flex;align-items:center;justify-content:space-between">
    <view>
      <view style="font-weight:700">不确定选哪个？</view>
      <view style="color:#8C8171;font-size:24rpx">11 道题，约 1 分钟，给出倾向参考</view>
    </view>
    <view class="chip on" bindtap="openQuiz">开始自评</view>
  </view>

  <!-- 忌口 -->
  <view class="section-title">忌口与偏好</view>
  <view class="section-sub">可多选，点一下选中，再点取消</view>
  <view class="chips">
    <view
      wx:for="{{constraintList}}"
      wx:key="name"
      class="chip {{item.on ? 'on' : ''}}"
      data-name="{{item.name}}"
      bindtap="toggleConstraint"
    >{{item.name}}</view>
  </view>

  <!-- 校区 -->
  <view class="section-title">食堂范围</view>
  <view class="chips">
    <view
      wx:for="{{campusList}}"
      wx:key="name"
      class="chip {{item.on ? 'on' : ''}}"
      data-name="{{item.name}}"
      bindtap="pickCampus"
    >{{item.name}}</view>
  </view>

  <view class="btn" bindtap="generate">生成今日推荐</view>
  <view class="btn ghost" bindtap="openRecord">两周记录</view>

  <view class="note">
    本小程序只做日常饮食参考，不用于诊断、开方，也不替代医生。
    如有持续不适或过敏，请及时就医。数据全部在本机，不联网、不上传。
  </view>
</view>
