/* 知源食养 · 全局样式（对齐网页 v3：深绿首屏 + 暖白正文） */
page {
  background: #FAF6EE;
  color: #2B251E;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  line-height: 1.7;
}

.wrap {
  padding: 20rpx 24rpx 120rpx;
}

/* ---------- 首屏：深绿 ---------- */
.hero {
  position: relative;
  border-radius: 24rpx;
  padding: 34rpx 30rpx 26rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #1E3A2B 0%, #2A4635 55%, #33513C 100%);
  box-shadow: 0 8rpx 24rpx rgba(30, 58, 43, 0.25);
}

/* 细网格纹理 */
.hero::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-image:
    repeating-linear-gradient(0deg, rgba(255, 253, 248, 0.05) 0, rgba(255, 253, 248, 0.05) 1rpx, transparent 1rpx, transparent 44rpx),
    repeating-linear-gradient(90deg, rgba(255, 253, 248, 0.05) 0, rgba(255, 253, 248, 0.05) 1rpx, transparent 1rpx, transparent 44rpx);
  pointer-events: none;
}

.hero-copy {
  position: relative;
  z-index: 3;
  padding-right: 224rpx;
}

.hero-kicker {
  font-size: 17rpx;
  letter-spacing: 4rpx;
  color: #E0AE4F;
  margin-bottom: 14rpx;
}

.hero-title {
  font-size: 46rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #FFFDF8;
  margin-bottom: 16rpx;
}

.hero-title .accent {
  color: #E8B44E;
}

.hero-desc {
  font-size: 23rpx;
  color: rgba(255, 253, 248, 0.72);
  line-height: 1.65;
}

/* 首屏数据芯片 */
.hero-chips {
  position: relative;
  z-index: 3;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 26rpx;
}

.hero-chips .hc {
  border: 2rpx solid rgba(224, 174, 79, 0.45);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  font-size: 21rpx;
  color: rgba(255, 253, 248, 0.82);
}

.hero-chips .hc text {
  color: #E8B44E;
  font-weight: 700;
}

/* 像素碗：20rpx 方块 */
.bowl {
  position: absolute;
  right: 10rpx;
  top: 40rpx;
  width: 216rpx;
  height: 240rpx;
  z-index: 2;
}

.bowl .px {
  position: absolute;
  box-sizing: border-box;
}

.steam {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  background: rgba(255, 253, 248, 0.85);
  animation: rise 3.2s steps(4) infinite;
}

@keyframes rise {
  0% { opacity: 0; transform: translateY(0); }
  30% { opacity: .9; }
  100% { opacity: 0; transform: translateY(-40rpx); }
}

/* ---------- 任务节点 ---------- */
.quest {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rpx;
  margin-top: 18rpx;
  border-radius: 16rpx;
  overflow: hidden;
  border: 2rpx solid #E4DBC9;
  background: #E4DBC9;
}

.quest .node {
  padding: 16rpx 18rpx;
  background: #FFFDF8;
  border-left: 4rpx solid #E4DBC9;
}

.quest .node.done {
  border-left-color: #5E7F52;
  background: #F4F8EF;
}

.quest .node.current {
  border-left-color: #B9643F;
  background: #FBF0E9;
}

.quest .node .t {
  font-size: 25rpx;
  font-weight: 700;
}

.quest .node.done .t { color: #5E7F52; }
.quest .node.current .t { color: #B9643F; }

.quest .node .s {
  font-size: 21rpx;
  color: #8C8171;
}

/* ---------- 进度条 ---------- */
.progress {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
  background: #FFFDF8;
  border: 2rpx solid #E4DBC9;
  border-radius: 16rpx;
  padding: 14rpx 18rpx;
  margin-top: 18rpx;
}

.progress .lab {
  font-size: 24rpx;
  color: #6B6152;
}

.progress .lab text {
  color: #2B251E;
  font-weight: 700;
}

.seg {
  display: flex;
  gap: 4rpx;
}

.seg .s {
  width: 20rpx;
  height: 12rpx;
  border-radius: 3rpx;
  background: #F5EFE2;
  border: 2rpx solid #E4DBC9;
}

.seg .s.on {
  background: #5E7F52;
  border-color: #5E7F52;
}

.seg .s.today {
  background: #C8973F;
  border-color: #C8973F;
}

/* ---------- 通用 ---------- */
.brand {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.tagline {
  color: #6B6152;
  font-size: 26rpx;
  margin-top: 8rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin: 34rpx 0 10rpx;
}

.section-sub {
  color: #8C8171;
  font-size: 24rpx;
  margin-bottom: 14rpx;
}

.card {
  background: #FFFDF8;
  border: 2rpx solid #E4DBC9;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 2rpx 8rpx rgba(59, 50, 39, 0.05);
}

/* 芯片 */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip {
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  border: 2rpx solid #E4DBC9;
  background: #FFFDF8;
  color: #6B6152;
  font-size: 28rpx;
}

.chip.on {
  background: #E7EEDF;
  border-color: #CBDCC0;
  color: #3F5A36;
  font-weight: 600;
}

/* 判定徽章 */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.badge-yi { background: #E7EEDF; color: #3F5A36; border: 2rpx solid #CBDCC0; }
.badge-shen { background: #F7ECD5; color: #7A5A1E; border: 2rpx solid #E8D5A8; }
.badge-jin { background: #F6E3D8; color: #8A4429; border: 2rpx solid #EBC7B6; }

/* 按钮 */
.btn {
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 14rpx;
  background: #5E7F52;
  color: #FFFFFF;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 28rpx;
}

.btn.ghost {
  background: #FFFDF8;
  color: #6B6152;
  border: 2rpx solid #E4DBC9;
}

.note {
  color: #8C8171;
  font-size: 22rpx;
  margin-top: 24rpx;
  line-height: 1.6;
}
