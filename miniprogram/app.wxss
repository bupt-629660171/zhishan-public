/* 知源食养 · 全局样式（对齐网页 v3） */
page {
  background: #FAF6EE;
  color: #2B251E;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  line-height: 1.7;
}

.wrap {
  padding: 24rpx 28rpx 120rpx;
}

/* ---------- 首屏 ---------- */
.hero {
  position: relative;
  background: #FFFDF8;
  border: 2rpx solid #E4DBC9;
  border-radius: 24rpx;
  padding: 36rpx 32rpx 28rpx;
  overflow: hidden;
}

.hero-kicker {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #B9643F;
  margin-bottom: 12rpx;
}

.hero-title {
  font-size: 52rpx;
  line-height: 1.3;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.hero-desc {
  font-size: 26rpx;
  color: #6B6152;
  max-width: 380rpx;
}

/* 像素碗：用方块拼，绝对定位 */
.bowl {
  position: absolute;
  right: 12rpx;
  top: 48rpx;
  width: 230rpx;
  height: 230rpx;
}

.bowl view {
  position: absolute;
  box-sizing: border-box;
}

.steam {
  position: absolute;
  right: 60rpx;
  top: 12rpx;
  width: 10rpx;
  height: 10rpx;
  background: #FFFFFF;
  border: 2rpx solid #E4DBC9;
  animation: rise 3s steps(4) infinite;
}

@keyframes rise {
  0% { opacity: 0; transform: translateY(0); }
  30% { opacity: 1; }
  100% { opacity: 0; transform: translateY(-40rpx); }
}

/* ---------- 进度条 ---------- */
.progress {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
  background: #FFFDF8;
  border: 2rpx solid #E4DBC9;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-top: 20rpx;
}

.progress .lab {
  font-size: 24rpx;
  color: #6B6152;
}

.progress .lab text {
  color: #2B251E;
  font-weight: 700;
}

.seg {
  display: flex;
  gap: 4rpx;
}

.seg view {
  width: 22rpx;
  height: 12rpx;
  border-radius: 3rpx;
  background: #F5EFE2;
  border: 2rpx solid #E4DBC9;
}

.seg view.on {
  background: #5E7F52;
  border-color: #5E7F52;
}

.seg view.today {
  background: #C8973F;
  border-color: #C8973F;
}

/* ---------- 任务节点 ---------- */
.quest {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rpx;
  margin-top: 16rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.quest .node {
  padding: 16rpx 18rpx;
  background: #FFFDF8;
  border-left: 4rpx solid #E4DBC9;
}

.quest .node.done {
  border-left-color: #5E7F52;
  background: #F4F8EF;
}

.quest .node.current {
  border-left-color: #B9643F;
  background: #FBF0E9;
}

.quest .node .t {
  font-size: 26rpx;
  font-weight: 700;
}

.quest .node.done .t { color: #5E7F52; }
.quest .node.current .t { color: #B9643F; }

.quest .node .s {
  font-size: 22rpx;
  color: #8C8171;
}

/* ---------- 通用 ---------- */
.brand {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.tagline {
  color: #6B6152;
  font-size: 26rpx;
  margin-top: 8rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin: 36rpx 0 12rpx;
}

.section-sub {
  color: #8C8171;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.card {
  background: #FFFDF8;
  border: 2rpx solid #E4DBC9;
  border-radius: 16rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(59, 50, 39, 0.05);
}

/* 芯片 */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip {
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  border: 2rpx solid #E4DBC9;
  background: #FFFDF8;
  color: #6B6152;
  font-size: 28rpx;
}

.chip.on {
  background: #E7EEDF;
  border-color: #CBDCC0;
  color: #3F5A36;
  font-weight: 600;
}

/* 判定徽章：图标 + 文字 + 底色 */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.badge-yi { background: #E7EEDF; color: #3F5A36; border: 2rpx solid #CBDCC0; }
.badge-shen { background: #F7ECD5; color: #7A5A1E; border: 2rpx solid #E8D5A8; }
.badge-jin { background: #F6E3D8; color: #8A4429; border: 2rpx solid #EBC7B6; }

/* 按钮 */
.btn {
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 14rpx;
  background: #5E7F52;
  color: #FFFFFF;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 28rpx;
}

.btn.ghost {
  background: #FFFDF8;
  color: #6B6152;
  border: 2rpx solid #E4DBC9;
}

.note {
  color: #8C8171;
  font-size: 22rpx;
  margin-top: 24rpx;
  line-height: 1.6;
}
